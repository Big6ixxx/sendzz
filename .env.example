NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ===========================================
# BITNOB API (Off-ramp)
# ===========================================
BITNOB_WEBHOOK_SECRET=""
BITNOB_CLIENT_ID=""
BITNOB_API_KEY=""
# How Bitnob funds a payout. Defaults to "onchain" (payout backed by the user's own deposit).
# Set to "offchain" ONLY to revert to funding payouts from our pooled USDC float.
BITNOB_PAYOUT_SOURCE=""

# Off-ramp corridors a provider must not be offered for, whatever its API claims it supports.
#
# Format: "CURRENCY:provider" pairs, comma separated.  e.g. "KES:bitnob,GHS:bitnob"
#
# UNSET  -> the in-code default applies (currently KES:bitnob, see OFFRAMP_BLOCKED in
#           lib/ramp/index.ts, blocked because Bitnob rejects network "SAFARICOM" on
#           KE mobile_money and every attempt strands the user's deposit).
# ""     -> clears the default entirely. This is how you restore a corridor once the
#           provider has fixed their end. Empty is meaningful here, not the same as unset.
#
# Blocking a provider also narrows the settlement chains offered for that currency, since the
# chains come from whichever providers can still serve it.
# RAMP_OFFRAMP_BLOCK=""

# Bitnob's per-corridor fee in USDC, charged ON TOP of the withdrawal amount. The user is
# debited base + platform fee + this, so Bitnob's deduction is covered by their own deposit
# instead of our float. Bitnob does NOT report these via the API (`fees` is always "0"), so set
# them from Bitnob's published rates. Unset = no corridor fee. Bitnob-only — Paycrest settles
# the quoted amount and has no equivalent.
# Bitnob's live corridors, one per currency:
BITNOB_CORRIDOR_FEE_NGN=""   # Nigeria — bank
BITNOB_CORRIDOR_FEE_KES=""   # Kenya — mobile money / paybill / paytill
BITNOB_CORRIDOR_FEE_RWF=""   # Rwanda — mobile money  (observed 0.3)
BITNOB_CORRIDOR_FEE_GHS=""   # Ghana — mobile money
BITNOB_CORRIDOR_FEE_UGX=""   # Uganda — mobile money
BITNOB_CORRIDOR_FEE_XOF=""   # Côte d'Ivoire, Senegal — mobile money
BITNOB_CORRIDOR_FEE_XAF=""   # Cameroon — mobile money
BITNOB_CORRIDOR_FEE_GMD=""   # Gambia — mobile money
BITNOB_CORRIDOR_FEE_USD=""   # swift / wire / ach

