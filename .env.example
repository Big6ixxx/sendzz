VAPID_PRIVATE_KEY=""

# ===========================================
# DIDIT KYC
# ===========================================
# API key from your Didit Business Console → API & Webhooks → API Keys
DIDIT_API_KEY=""
# Workflow ID from your Didit Business Console → Workflows → your KYC workflow
DIDIT_WORKFLOW_ID=""
# Webhook signing secret from Didit Business Console → API & Webhooks → Destinations
# Used to verify HMAC-SHA256 signatures on incoming webhook events (X-Signature-V2)
DIDIT_WEBHOOK_SECRET=""


# ===========================================
# WEBAUTHN / PASSKEY
# ===========================================
# The domain users will access the app on (NO port, NO protocol)
# e.g. "sendzz.com" for production, "localhost" for local dev
WEBAUTHN_RP_ID=""
# The full origin URL (protocol + domain + optional port)
# e.g. "https://sendzz.com" for production, "http://localhost:3000" for local dev
WEBAUTHN_ORIGIN=""