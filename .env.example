# ===========================================
# SENDZZ ENVIRONMENT CONFIGURATION
# ===========================================

# App Configuration
NEXT_PUBLIC_APP_URL=""

# ===========================================
# SUPABASE
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ===========================================
# STELLAR (network-scoped)
# ===========================================
# The generic NEXT_PUBLIC_STELLAR_* variables apply on MAINNET ONLY. On testnet they are
# ignored and the *_TESTNET variants are used instead, so mainnet values in this file can
# never leak into a testnet run. Sensible testnet defaults are built in — you normally
# need none of these.
#
#   NEXT_PUBLIC_STELLAR_HORIZON_URL_TESTNET
#   NEXT_PUBLIC_STELLAR_RPC_URL_TESTNET
#   NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE_TESTNET
#   NEXT_PUBLIC_STELLAR_USDC_ISSUER_TESTNET
#   NEXT_PUBLIC_STELLAR_USDC_CONTRACT_TESTNET
#   NEXT_PUBLIC_STELLAR_TOKEN_MESSENGER_CONTRACT_TESTNET
#   NEXT_PUBLIC_STELLAR_MESSAGE_TRANSMITTER_CONTRACT_TESTNET
#   NEXT_PUBLIC_STELLAR_CCTP_FORWARDER_TESTNET
#
# Circle's Stellar CCTP contracts (domain 27) are deployed on BOTH mainnet and testnet,
# and both sets are built in — bridging to and from Stellar works on testnet.
#
# Sponsor account that funds new user wallets (1.6 XLM each) and fee-bumps trustlines.
# On testnet, STELLAR_SPONSOR_SECRET_KEY_TESTNET wins if set; otherwise the shared key is
# reused, which is safe because a signature cannot replay across networks. Fund whichever
# public key you use at https://friendbot.stellar.org?addr=<public key>
STELLAR_SPONSOR_SECRET_KEY=""
# STELLAR_SPONSOR_SECRET_KEY_TESTNET=""

# Marks THIS database as safe for testnet writes. Leave unset for production.
#
# When NEXT_PUBLIC_SIMULATION_MODE="true", the app refuses to write to any database that
# is not marked "testnet" — transfers, claims and bridges all fail loudly rather than
# writing testnet rows into production tables.
#
#   unset / anything else  → production database, testnet writes blocked
#   "testnet"              → testnet database, writes allowed
#
# IMPORTANT: this label cannot override a known production project. Setting it next to a
# production SUPABASE_URL is ignored and writes stay blocked — that exact mistake once put
# a test user and a test bridge into the live tables. Production project refs are listed
# in PRODUCTION_PROJECT_REFS in lib/supabase/network-guard.ts; add yours there.
#
# To use this properly, create a SEPARATE Supabase project and apply the schema with:
#   scripts/setup-testnet-db.sh "<new project's postgres connection URI>"
NEXT_PUBLIC_SUPABASE_NETWORK=""

# ===========================================
# BITNOB API (Off-ramp)
# ===========================================
BITNOB_WEBHOOK_SECRET=""
BITNOB_CLIENT_ID=""
BITNOB_API_KEY=""

# ===========================================
# DECENTRALIZED IDENTITY & WALLETS
# ===========================================
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# RPC URLs — optional, one per chain: <CHAIN>_RPC_URL
# Overrides the default endpoint for that chain. Without one, the app uses Alchemy
# (if NEXT_PUBLIC_ALCHEMY_API_KEY is set and the network is enabled on the app),
# then falls back to a public endpoint. Set these to avoid public rate limits.
BASE_RPC_URL=""
POLYGON_RPC_URL=""
ARBITRUM_RPC_URL=""
OPTIMISM_RPC_URL=""
AVALANCHE_RPC_URL=""
ETHEREUM_RPC_URL=""

# ===========================================
# NETWORK FAMILY  (the only switch that matters)
# ===========================================
# This one variable selects the network family for the entire app — chain ids, RPCs,
# USDC contracts, CCTP domains and contracts, Circle bundler endpoints, block explorers
# and the home settlement chain. There is no second place to change.
#
#   "true"   testnet  — Arc Testnet, Base Sepolia, Arbitrum Sepolia, OP Sepolia,
#                       Polygon Amoy, Avalanche Fuji, Solana devnet, Stellar testnet.
#                       Settles on Arc. CCTP goes through Circle's Iris sandbox.
#   "false"  mainnet  — Base, Arbitrum, Optimism, Polygon, Avalanche, Solana, Stellar.
#                       Settles on Base. Arc disappears entirely (it has no mainnet).
#
# Unset behaves as "true": a missing value must never silently point a preview build at
# real funds. Define this key exactly ONCE — a duplicate later in the file wins silently
# and pins the app to whichever value happens to come last.
NEXT_PUBLIC_SIMULATION_MODE="true"

# ===========================================
# CIRCLE (Cross-chain USDC / CCTP)
# ===========================================
# Circle keys are scoped to an environment and MUST match NEXT_PUBLIC_SIMULATION_MODE:
#
#   SIMULATION_MODE="true"   → TEST_API_KEY… / TEST_CLIENT_KEY…
#   SIMULATION_MODE="false"  → LIVE_API_KEY… / LIVE_CLIENT_KEY…
#
# The endpoint URLs below are the SAME for both — only the key changes. Mixing them fails
# with "TEST_API key cannot be used with blockchain mainnets, or LIVE_API key cannot be
# used with testnets", which reads like a bad RPC parameter but is a credentials problem.
# The app now checks this pairing up front and says so plainly.
# Both key types come from the same place: console.circle.com.
CIRCLE_API_KEY=""
CIRCLE_ENTITY_SECRET=""
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=""

# Circle Developer Wallets
CIRCLE_WALLET_SET_ID=""
CIRCLE_SOLANA_FEEPAYER_WALLET_ID=""
CIRCLE_SOLANA_FEEPAYER_ADDRESS=""
NEXT_PUBLIC_CIRCLE_READ_URL=""
NEXT_PUBLIC_CIRCLE_SEND_URL=""

# ===========================================
# PAYCREST
# ===========================================
PAYCREST_API_KEY=""
PAYCREST_API_SECRET=""
NEXT_PUBLIC_PAYCREST_API_URL=""

NEXT_PUBLIC_ALCHEMY_API_KEY=""

# Circle Gas Station Policy IDs — one per source chain
# Get these from the Circle Developer Console → Gas Station → Policies
# Create a separate policy for each chain you want to sponsor gas on
NEXT_PUBLIC_CIRCLE_GAS_POLICY_ARBITRUM=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_AVALANCHE=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_ETHEREUM=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_OPTIMISM=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_POLYGON=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_SOLANA=""

# Testnet policies are a separate set, because a policy belongs to the Circle account
# that created it — a LIVE policy id passed as paymaster context is rejected by a TEST
# key. These are read only when NEXT_PUBLIC_SIMULATION_MODE is "true", and leaving them
# empty is fine: the app falls back to Circle's default paymaster, which is the right
# behaviour on testnet. Set them only if you create Gas Station policies on a test account.
NEXT_PUBLIC_CIRCLE_GAS_POLICY_ARBITRUM_TESTNET=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_AVALANCHE_TESTNET=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_OPTIMISM_TESTNET=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_POLYGON_TESTNET=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_BASE_TESTNET=""
NEXT_PUBLIC_CIRCLE_GAS_POLICY_ARC_TESTNET=""

RESEND_API_KEY=""


