# ===========================================
# PLATFORM FEES
# ===========================================
# Percentages, not basis points: "0.5" means 0.5%.
# All arithmetic goes through lib/ramp/fees.ts and lib/fees/platform-fees.ts — never inline a
# multiplier. There is no compiled-in default anywhere: an unset rate throws rather than
# silently charging zero, so the charged fee and the displayed fee cannot diverge.
#
# DEPOSITS ARE FREE. They used to carry a fee that Paycrest skimmed on their side; that is now
# set to 0 on the Paycrest dashboard and removed from the app. Money coming IN is not charged
# for. If you ever re-enable a partner fee on their dashboard without changing the code, users
# would be charged silently with nothing shown in the UI — so don't.

# The standard withdrawal rate, applied to every corridor that has no override below.
WITHDRAWAL_FEE_PERCENT="0.5"

# Per-corridor overrides, for corridors that genuinely cost more to serve. Unset = standard
# rate. These change what the USER pays; they deliberately do NOT change what a referrer
# earns, which is a fixed share of volume (see REFERRALS below) — so repricing a corridor
# cannot silently reprice the referral programme with it.
# WITHDRAWAL_FEE_PERCENT_NGN="0.5"
# WITHDRAWAL_FEE_PERCENT_KES="1"
# WITHDRAWAL_FEE_PERCENT_GHS="1"

# On-chain transfers to an external wallet. Transfers sent by email are free.
TRANSFER_FEE_PERCENT=""
# Bridging USDC between networks.
BRIDGE_FEE_PERCENT=""

# DEPRECATED — read only as a fallback so a deployment mid-rename keeps charging instead of
# refusing every withdrawal. Set WITHDRAWAL_FEE_PERCENT and delete these.
# PAYCREST_FEE_PERCENT=""
# BITNOB_FEE_PERCENT=""

# Flat per-corridor cost that the PROVIDER deducts, in USDC. Not our revenue — it is a cost,
# and it is subtracted before a referrer's share is worked out. Configured rather than read
# from the API because Bitnob reports "0" on every quote and still deducts on some corridors.
# BITNOB_CORRIDOR_FEE_NGN="0.20"
# BITNOB_CORRIDOR_FEE_KES="0.20"

# ===========================================
# FEE TREASURY ADDRESSES
# ===========================================
# Where every platform fee is collected on-chain, per settlement network — withdrawals,
# bridges and external sends all land here. A self-custodial wallet you hold the keys to.
#
# A withdrawal is REFUSED on a network with no treasury configured rather than settling
# without collecting the fee, so set one for every chain you support. Now that BOTH ramp
# providers collect on-chain, an unconfigured chain stops Paycrest withdrawals too, not just
# Bitnob ones.
FEE_TREASURY_BASE=""
FEE_TREASURY_POLYGON=""
FEE_TREASURY_ETHEREUM=""
FEE_TREASURY_ARBITRUM=""
FEE_TREASURY_OPTIMISM=""
FEE_TREASURY_AVALANCHE=""
FEE_TREASURY_SOLANA=""
FEE_TREASURY_STELLAR=""
FEE_TREASURY_ARC=""

# DEPRECATED — BITNOB_FEE_TREASURY_<CHAIN> is still read as a fallback, with a warning. The
# name was always a misnomer: these addresses serve bridges and external sends too, and now
# both ramp providers. Rename to FEE_TREASURY_<CHAIN> and delete the old ones.

# ===========================================
# ADMIN & OPERATIONS
# ===========================================
# Comma-separated. Grants access to /admin AND receives operational alerts —
# notably "refund owed", sent when a withdrawal fails after the user's deposit
# landed and their USDC has to be returned by hand.
# If this is empty nobody is alerted, and the failure is only visible in the logs.
ADMIN_EMAILS=""

# Bearer token the reconcile cron must present. Set it here AND in the scheduled
# job, or the endpoint is reachable by anyone.
#   curl -H "Authorization: Bearer $CRON_SECRET" https://your-domain/api/cron/reconcile-transactions
# Run it every 2 minutes: it recovers withdrawals whose payout was never completed,
# and a payout quote only lives ~16 minutes.
CRON_SECRET=""

# Dune API key, Read/Write scope, created at https://dune.com/apis?tab=keys
# Create it in the same account context (personal vs team) that owns the dataset.
# Only used by /api/cron/sync-dune-roster, which publishes our wallet addresses so the public
# dashboard can scope on-chain queries to Sendzz users. Optional: leave it empty and the route
# returns 503 without doing anything. The same roster can be uploaded by hand from Dune's
# Create -> Upload data screen, so the dashboard does not depend on this being set.
# Daily is plenty — it only needs to catch new signups.
DUNE_API_KEY=""

# ===========================================
# SUPPORT
# ===========================================
# Telegram group or account the support widget hands users off to.
# Shown on the dashboard and the home page. Without it the button points at a
# placeholder that goes nowhere.
NEXT_PUBLIC_SUPPORT_TELEGRAM_URL=""

# ===========================================
# ENVIRONMENT
# ===========================================
# "mainnet" or "testnet" — which Supabase project and chain set the app runs against.
NEXT_PUBLIC_SUPABASE_NETWORK=""

# ===========================================
# TRANSACTION PIN
# ===========================================
# Server-side secret mixed into every PIN before it is hashed. A 4-digit PIN is only 10,000
# possibilities, so a stolen database alone would be enough to test every one of them — this
# is the piece that is NOT in the database, so a dump cannot even construct a guess.
#
# Generate once:   openssl rand -base64 32
# Minimum 16 characters. Below that the app refuses to hash a PIN at all rather than
# storing a weaker one.
#
# NEVER change it once users have PINs: every stored PIN is derived from it, so changing it
# locks everyone out at once with no way to recover. Treat it like the service role key.
#
# REQUIRED IN EVERY ENVIRONMENT. The PIN now gates every outgoing transaction, so a deployment
# without this cannot hash or verify one — which means nobody can send, withdraw or bridge.
# It is not an optional hardening step any more; the app is non-functional without it.
PIN_PEPPER=""

# The PIN reset path emails a code, and that code is encrypted at rest with TOTP_ENCRYPTION_KEY
# (set under the 2FA section above). Without it, a user who forgets their PIN has no way back
# in — so that variable is now load-bearing for recovery, not just for authenticator secrets.


# ===========================================
# REFERRALS
# ===========================================
# A referrer earns a FIXED PERCENTAGE OF WITHDRAWAL VOLUME — not a fixed share of the fee.
#
# The difference only shows up when a corridor is not priced at the reference rate:
#
#   corridor at 0.5%  ->  Gold earns 0.25% of volume  =  half the fee
#   corridor at 1.0%  ->  Gold earns 0.25% of volume  =  a quarter of the fee
#
# That is deliberate. Corridor pricing is a commercial decision about what the USER pays, and
# repricing a corridor must not silently reprice what we owe our affiliates.
#
# Only withdrawals earn. Deposits are free, so there is no fee to share on the way in, and an
# on-chain arrival costs the sender nothing and earns us nothing — paying a share of those
# would be farmable by depositing and withdrawing in a loop.

# The corridor rate the tier percentages below are expressed against. Changing this moves
# every tier's volume rate together, so it is a deliberate decision rather than a side effect
# of repricing a corridor. Keep it equal to your standard WITHDRAWAL_FEE_PERCENT.
REFERRAL_REFERENCE_FEE_PERCENT="0.5"

# Tiers, quoted as a share of the fee on that reference corridor, and the monthly network
# withdrawal volume each requires. Defaults shown; set only what you want to change.
#   Bronze  20% of a 0.5% fee  ->  0.10%  of volume     from $0
#   Silver  35% of a 0.5% fee  ->  0.175% of volume     from $5,000/month
#   Gold    50% of a 0.5% fee  ->  0.25%  of volume     from $25,000/month
# REFERRAL_TIER_BRONZE_FEE_SHARE="20"
# REFERRAL_TIER_BRONZE_MIN_VOLUME="0"
# REFERRAL_TIER_SILVER_FEE_SHARE="35"
# REFERRAL_TIER_SILVER_MIN_VOLUME="5000"
# REFERRAL_TIER_GOLD_FEE_SHARE="50"
# REFERRAL_TIER_GOLD_MIN_VOLUME="25000"

# Insurance, not pricing. A flat volume rate takes no account of what a withdrawal actually
# netted, which is fine until a flat corridor cost eats a small withdrawal's fee: on $50 at
# 0.5% with a $0.20 corridor cost we net $0.05, while 0.25% of volume would pay $0.125 — two
# and a half times our margin, out of pocket.
#
# At 90 this is invisible on healthy corridors and Gold receives exactly the 0.25% it is
# promised; it engages only where the alternative is a loss. Lowering it would quietly pay
# affiliates less than the rate they were quoted, which is the worse failure. Default 90.
# REFERRAL_MAX_NET_SHARE_PERCENT="90"

# The smallest withdrawal that earns a commission. Below this, flat corridor costs dominate
# and the commission is noise on a margin that barely exists. Default 50.
# REFERRAL_MIN_WITHDRAWAL_USDC="50"

# The balance a referrer has to reach before a payout is sent. Below this, earnings wait.
# Commissions are usually cents, and one transfer each would cost more in gas than the
# payment is worth. Default 5.
REFERRAL_MIN_PAYOUT_USDC="5"

# ── Payout treasury (Circle developer-controlled wallet, on Base) ────────────
# The wallet referral payouts are sent FROM. Different from FEE_TREASURY_* above: those only
# RECEIVE, so an address is enough. Paying out means signing, which needs a wallet Circle
# holds the keys for.
#
# It does NOT refill itself. Fee revenue lands in FEE_TREASURY_<CHAIN>, which is a
# self-custodial EOA — the cron cannot sign from that through Circle's API, so topping up is a
# deliberate transfer. (Alternative: point FEE_TREASURY_BASE at this same Circle wallet, and
# Base fees flow straight into the wallet the cron spends from.)
#
# Until all four Circle vars are set the payout cron refuses to run and says what is missing.
# Nothing is lost meanwhile — earnings keep accruing, and the first configured run pays them.
# The cron also emails ADMIN_EMAILS before the balance runs dry.
#
#   1. Circle console -> Wallets -> create a wallet set (or reuse CIRCLE_WALLET_SET_ID)
#   2. Create a wallet on BASE in that set — note its id and address
#   3. Fund the address with USDC (and a little ETH for gas if not using a gas policy)
#   4. Look up the USDC token id for Base via Circle's /v1/w3s/tokens endpoint
CIRCLE_PAYOUT_WALLET_ID=""
# Circle's internal token id for USDC on Base — NOT the USDC contract address.
CIRCLE_PAYOUT_USDC_TOKEN_ID=""

# This wallet does NOT refill itself, and that is worth being explicit about. Deposit revenue
# sits in your Paycrest account (they skim the partner fee on their side, so it never touches a
# chain), and bridge and withdrawal fees go to the BITNOB_FEE_TREASURY_* addresses above, which
# are Bitnob-hosted — they credit your Bitnob balance, not a wallet you hold keys to. Topping
# this one up means withdrawing from those and sending USDC to it on Base.
#
# The payout cron watches the balance and emails ADMIN_EMAILS before payouts stall. If it runs
# dry nothing is lost or double-paid — earnings are released and retried each run — but
# referral payments stop arriving until it is funded, which is exactly the kind of silence the
# alert exists to break.
